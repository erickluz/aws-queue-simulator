{
  "name": "aws-queue-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "verify:controls": "node scripts/verify-controls.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "verify:engine": "node scripts/verify-engine.mjs",
    "verify:delivery": "node scripts/verify-engine.mjs src/verify-delivery.ts",
    "verify:flow": "node scripts/verify-flow.mjs",
    "verify:canvas-actions": "node scripts/verify-engine.mjs src/verify-canvas-actions.ts",
    "verify:worker-visual": "node scripts/verify-engine.mjs src/verify-worker-visual.ts",
    "verify:auto-poll": "node scripts/verify-engine.mjs src/verify-auto-poll.ts",
    "verify:batch": "node scripts/verify-engine.mjs src/verify-batch.ts",
    "verify:routing": "node scripts/verify-engine.mjs src/verify-routing.ts",
    "verify:production": "node scripts/verify-engine.mjs src/verify-production.ts",
    "verify:worker-canvas": "node scripts/verify-engine.mjs src/verify-worker-canvas.ts"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
